@page
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser<Guid>> SignInManager
@inject UserManager<IdentityUser<Guid>> UserManager

@{
    ViewData["Title"] = "Team Lead Dashboard";
}

<div class="container">
    <h1>Team Lead Dashboard</h1>
    <p>Welcome, @User.Identity?.Name!</p>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3>My Projects</h3>
                </div>
                <div class="card-body">
                    <p>Active Projects: <span class="badge badge-primary">0</span></p>
                    <p>Total Tasks: <span class="badge badge-info">0</span></p>
                    <p>Tasks Completed: <span class="badge badge-success">0</span></p>
                    <p>Tasks In Progress: <span class="badge badge-warning">0</span></p>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3>Team Status</h3>
                </div>
                <div class="card-body">
                    <p>Team Members: <span class="badge badge-primary">0</span></p>
                    <p>Available Now: <span class="badge badge-success">0</span></p>
                    <p>Busy: <span class="badge badge-warning">0</span></p>
                    <p>On Leave: <span class="badge badge-danger">0</span></p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3>Recent Task Updates</h3>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Task</th>
                                    <th>Assigned To</th>
                                    <th>Status</th>
                                    <th>Last Updated</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="4" class="text-center">No recent updates</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3>Quick Actions</h3>
                </div>
                <div class="card-body">
                    <a href="/TeamLead/AssignTask" class="btn btn-primary">Assign Task</a>
                    <a href="/TeamLead/Tasks" class="btn btn-secondary">View All Tasks</a>
                    <a href="/TeamLead/TeamPerformance" class="btn btn-info">Team Performance</a>
                </div>
            </div>
        </div>
    </div>
</div>
