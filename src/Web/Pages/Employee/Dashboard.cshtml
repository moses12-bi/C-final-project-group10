@page
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser<Guid>> SignInManager
@inject UserManager<IdentityUser<Guid>> UserManager

@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container">
    <h1>Employee Dashboard</h1>
    <p>Welcome, @User.Identity?.Name!</p>
    
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h3>My Tasks</h3>
                </div>
                <div class="card-body">
                    <p>Total Assigned: <span class="badge badge-primary">0</span></p>
                    <p>To Do: <span class="badge badge-warning">0</span></p>
                    <p>In Progress: <span class="badge badge-info">0</span></p>
                    <p>Completed: <span class="badge badge-success">0</span></p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h3>Performance</h3>
                </div>
                <div class="card-body">
                    <p>Tasks This Week: <span class="badge badge-primary">0</span></p>
                    <p>Completed This Week: <span class="badge badge-success">0</span></p>
                    <p>Average Completion Time: <span class="badge badge-info">0 days</span></p>
                    <p>Performance Score: <span class="badge badge-warning">0</span></p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h3>Notifications</h3>
                </div>
                <div class="card-body">
                    <p>Unread: <span class="badge badge-danger">0</span></p>
                    <p>Total Today: <span class="badge badge-primary">0</span></p>
                    <div class="mt-2">
                        <small class="text-muted">No new notifications</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3>My Recent Tasks</h3>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Task Title</th>
                                    <th>Project</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th>Due Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="6" class="text-center">No tasks assigned</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3>Quick Actions</h3>
                </div>
                <div class="card-body">
                    <a href="/Employee/MyTasks" class="btn btn-primary">View All Tasks</a>
                    <a href="/Employee/UpdateTask" class="btn btn-secondary">Update Task Status</a>
                    <a href="/Employee/Profile" class="btn btn-info">Update Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>
