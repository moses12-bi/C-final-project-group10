@page
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser<Guid>> SignInManager
@inject UserManager<IdentityUser<Guid>> UserManager

@{
    ViewData["Title"] = "Create Project";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>Create New Project</h3>
                </div>
                <div class="card-body">
                    <form method="post" id="createProjectForm">
                        <div class="mb-3">
                            <label for="projectName" class="form-label">Project Name</label>
                            <input type="text" class="form-control" id="projectName" name="Name" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="projectDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="projectDescription" name="Description" rows="4" required></textarea>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="startDate" class="form-label">Start Date</label>
                                    <input type="date" class="form-control" id="startDate" name="StartDate" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="endDate" class="form-label">End Date (Optional)</label>
                                    <input type="date" class="form-control" id="endDate" name="EndDate">
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="riskLevel" class="form-label">Risk Level</label>
                            <select class="form-select" id="riskLevel" name="RiskLevel" required>
                                <option value="0.1">Very Low</option>
                                <option value="0.3">Low</option>
                                <option value="0.5" selected>Medium</option>
                                <option value="0.7">High</option>
                                <option value="0.9">Very High</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label for="teamLeadId" class="form-label">Team Lead</label>
                            <select class="form-select" id="teamLeadId" name="TeamLeadId" required>
                                <option value="">Select Team Lead</option>
                                <!-- Team leads will be populated dynamically -->
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Team Members</label>
                            <div id="teamMembersContainer">
                                <div class="row mb-2">
                                    <div class="col-md-8">
                                        <select class="form-select team-member-select">
                                            <option value="">Select Team Member</option>
                                            <!-- Team members will be populated dynamically -->
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <input type="number" class="form-control allocation-input" placeholder="Allocation %" min="1" max="100" value="100">
                                    </div>
                                    <div class="col-md-1">
                                        <button type="button" class="btn btn-danger btn-sm" onclick="removeTeamMember(this)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-secondary btn-sm mt-2" onclick="addTeamMember()">
                                <i class="fas fa-plus"></i> Add Team Member
                            </button>
                        </div>
                        
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="getRecommendations" onchange="toggleRecommendations()">
                                <label class="form-check-label" for="getRecommendations">
                                    Get AI recommendations for team composition
                                </label>
                            </div>
                        </div>
                        
                        <div id="recommendationsSection" style="display: none;">
                            <h5>AI Recommendations</h5>
                            <div id="recommendationsContent">
                                <!-- Recommendations will be loaded here -->
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a href="/Manager/Dashboard" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Create Project</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let teamMemberCounter = 0;

        async function loadUsers() {
            try {
                const response = await fetch('/api/users');
                const users = await response.json();
                
                const teamLeadSelect = document.getElementById('teamLeadId');
                const teamMemberSelects = document.querySelectorAll('.team-member-select');
                
                // Populate team leads
                users.filter(u => u.role === 'TeamLead').forEach(user => {
                    const option = new Option(user.fullName, user.id);
                    teamLeadSelect.add(option);
                });
                
                // Populate team members
                users.filter(u => u.role === 'Employee' || u.role === 'TeamLead').forEach(user => {
                    teamMemberSelects.forEach(select => {
                        const option = new Option(user.fullName, user.id);
                        select.add(option);
                    });
                });
            } catch (error) {
                console.error('Error loading users:', error);
            }
        }

        function addTeamMember() {
            teamMemberCounter++;
            const container = document.getElementById('teamMembersContainer');
            const newMemberRow = document.createElement('div');
            newMemberRow.className = 'row mb-2';
            newMemberRow.innerHTML = `
                <div class="col-md-8">
                    <select class="form-select team-member-select" name="TeamMemberIds[${teamMemberCounter}].UserId">
                        <option value="">Select Team Member</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <input type="number" class="form-control allocation-input" name="TeamMemberIds[${teamMemberCounter}].AllocationPercent" placeholder="Allocation %" min="1" max="100" value="100">
                </div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeTeamMember(this)">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            `;
            
            container.appendChild(newMemberRow);
            
            // Load users for the new select
            loadUsers();
        }

        function removeTeamMember(button) {
            button.closest('.row').remove();
        }

        async function toggleRecommendations() {
            const checkbox = document.getElementById('getRecommendations');
            const recommendationsSection = document.getElementById('recommendationsSection');
            
            if (checkbox.checked) {
                recommendationsSection.style.display = 'block';
                await loadRecommendations();
            } else {
                recommendationsSection.style.display = 'none';
            }
        }

        async function loadRecommendations() {
            try {
                const projectName = document.getElementById('projectName').value;
                const projectDescription = document.getElementById('projectDescription').value;
                const riskLevel = parseFloat(document.getElementById('riskLevel').value);
                
                // This would call an API endpoint to get recommendations
                // For now, we'll show placeholder recommendations
                const recommendations = [
                    { employeeId: '1', employeeName: 'John Doe', score: 0.95, rationale: 'Strong skills match and good availability' },
                    { employeeId: '2', employeeName: 'Jane Smith', score: 0.87, rationale: 'Excellent past performance on similar projects' },
                    { employeeId: '3', employeeName: 'Bob Johnson', score: 0.82, rationale: 'Good workload availability and relevant experience' }
                ];
                
                const content = document.getElementById('recommendationsContent');
                content.innerHTML = recommendations.map(rec => `
                    <div class="card mb-2">
                        <div class="card-body py-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>${rec.employeeName}</strong>
                                    <div class="text-muted small">${rec.rationale}</div>
                                </div>
                                <div>
                                    <span class="badge bg-primary">${(rec.score * 100).toFixed(0)}% Match</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary ms-2" onclick="selectRecommendedMember('${rec.employeeId}', '${rec.employeeName}')">
                                        Select
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `).join('');
            } catch (error) {
                console.error('Error loading recommendations:', error);
            }
        }

        function selectRecommendedMember(employeeId, employeeName) {
            // Add the recommended member to the team members list
            addTeamMember();
            const lastSelect = document.querySelector('.team-member-select:last-of-type');
            lastSelect.value = employeeId;
            
            showNotification(`Added ${employeeName} to the team`, 'success');
        }

        function showNotification(message, type) {
            const toast = document.createElement('div');
            toast.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            toast.style.cssText = 'top: 20px; right: 20px; z-index: 1050; min-width: 300px;';
            toast.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.remove();
            }, 5000);
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            loadUsers();
        });
    </script>
}
