@page
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser<Guid>> SignInManager
@inject UserManager<IdentityUser<Guid>> UserManager

@{
    ViewData["Title"] = "Manager Dashboard";
}

<style>
.dashboard-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 2rem 0;
    margin-bottom: 2rem;
    border-radius: 0 0 1rem 1rem;
}

.dashboard-header h1 {
    font-weight: 300;
    margin-bottom: 0.5rem;
}

.dashboard-header .welcome-text {
    opacity: 0.9;
    font-size: 1.1rem;
}

.stats-card {
    border: none;
    border-radius: 1rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
}

.stats-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 20px rgba(0, 0, 0, 0.15);
}

.stats-card .card-header {
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    border: none;
    border-radius: 1rem 1rem 0 0;
    padding: 1.5rem;
}

.stats-card .card-body {
    padding: 2rem;
}

.stat-number {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
}

.stat-label {
    color: #6c757d;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.badge-custom {
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    font-weight: 500;
}

.quick-actions-card {
    border: none;
    border-radius: 1rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
}

.quick-actions-card .card-header {
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    color: white;
    border: none;
    border-radius: 1rem 1rem 0 0;
}

.btn-action {
    border-radius: 2rem;
    padding: 0.75rem 2rem;
    font-weight: 500;
    margin: 0.25rem;
    transition: all 0.3s ease;
}

.btn-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
}

.activity-item {
    padding: 1rem;
    border-left: 4px solid #667eea;
    margin-bottom: 1rem;
    background: #f8f9fa;
    border-radius: 0 0.5rem 0.5rem 0;
    transition: background-color 0.3s ease;
}

.activity-item:hover {
    background: #e9ecef;
}

.activity-time {
    font-size: 0.8rem;
    color: #6c757d;
}

.chart-container {
    position: relative;
    height: 300px;
    margin: 1rem 0;
}

.progress-custom {
    height: 0.5rem;
    border-radius: 1rem;
    background: #e9ecef;
}

.progress-bar-custom {
    border-radius: 1rem;
}
</style>

<div class="dashboard-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1><i class="fas fa-chart-line me-3"></i>Manager Dashboard</h1>
                <p class="welcome-text mb-0">Welcome back, @User.Identity?.Name! Here's your project overview.</p>
            </div>
            <div class="col-md-4 text-end">
                <div class="d-flex align-items-center justify-content-end">
                    <div class="me-3">
                        <small class="d-block opacity-75">Current Time</small>
                        <strong>@DateTime.Now.ToString("HH:mm")</strong>
                    </div>
                    <div class="avatar-circle">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card stats-card">
                <div class="card-header text-center">
                    <i class="fas fa-project-diagram fa-2x mb-3 text-primary"></i>
                    <h5 class="mb-0">Projects Overview</h5>
                </div>
                <div class="card-body text-center">
                    <div class="stat-number text-primary">12</div>
                    <div class="stat-label">Total Projects</div>
                    <div class="mt-3">
                        <span class="badge badge-custom bg-success">8 Active</span>
                        <span class="badge badge-custom bg-info">3 Completed</span>
                        <span class="badge badge-custom bg-warning">1 On Hold</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card stats-card">
                <div class="card-header text-center">
                    <i class="fas fa-users fa-2x mb-3 text-success"></i>
                    <h5 class="mb-0">Team Performance</h5>
                </div>
                <div class="card-body text-center">
                    <div class="stat-number text-success">24</div>
                    <div class="stat-label">Team Members</div>
                    <div class="mt-3">
                        <div class="progress progress-custom mb-2">
                            <div class="progress-bar progress-bar-custom bg-success" style="width: 78%"></div>
                        </div>
                        <small class="text-muted">78% Productivity</small>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card stats-card">
                <div class="card-header text-center">
                    <i class="fas fa-tasks fa-2x mb-3 text-info"></i>
                    <h5 class="mb-0">Task Status</h5>
                </div>
                <div class="card-body text-center">
                    <div class="stat-number text-info">156</div>
                    <div class="stat-label">Total Tasks</div>
                    <div class="mt-3">
                        <div class="row text-center">
                            <div class="col-4">
                                <small class="d-block text-success">45 Done</small>
                            </div>
                            <div class="col-4">
                                <small class="d-block text-warning">78 Progress</small>
                            </div>
                            <div class="col-4">
                                <small class="d-block text-danger">33 Overdue</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card stats-card">
                <div class="card-header text-center">
                    <i class="fas fa-chart-line fa-2x mb-3 text-warning"></i>
                    <h5 class="mb-0">Performance Metrics</h5>
                </div>
                <div class="card-body text-center">
                    <div class="stat-number text-warning">92%</div>
                    <div class="stat-label">On-Time Delivery</div>
                    <div class="mt-3">
                        <small class="text-success"><i class="fas fa-arrow-up"></i> +5% from last month</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Charts and Activity -->
    <div class="row mb-4">
        <div class="col-lg-8 mb-4">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-chart-area me-2"></i>Project Progress Overview</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="projectProgressChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4 mb-4">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-bell me-2"></i>Recent Activity</h5>
                </div>
                <div class="card-body">
                    <div class="activity-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>New project created</strong>
                                <div class="text-muted small">Website Redesign</div>
                            </div>
                            <span class="activity-time">2h ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>Task completed</strong>
                                <div class="text-muted small">Database Schema Design</div>
                            </div>
                            <span class="activity-time">4h ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>Team member assigned</strong>
                                <div class="text-muted small">John Doe to Mobile App</div>
                            </div>
                            <span class="activity-time">6h ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>Risk alert</strong>
                                <div class="text-muted small">Budget exceeded on Project X</div>
                            </div>
                            <span class="activity-time">1d ago</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Quick Actions -->
    <div class="row">
        <div class="col-12">
            <div class="card quick-actions-card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-rocket me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body text-center">
                    <a href="/Manager/CreateProject" class="btn btn-primary btn-action">
                        <i class="fas fa-plus-circle me-2"></i>Create New Project
                    </a>
                    <a href="/Manager/Projects" class="btn btn-success btn-action">
                        <i class="fas fa-list me-2"></i>View All Projects
                    </a>
                    <a href="/Manager/TeamMembers" class="btn btn-info btn-action">
                        <i class="fas fa-users me-2"></i>Manage Team
                    </a>
                    <a href="/Manager/Reports" class="btn btn-warning btn-action">
                        <i class="fas fa-chart-bar me-2"></i>View Reports
                    </a>
                    <a href="/Manager/Settings" class="btn btn-secondary btn-action">
                        <i class="fas fa-cog me-2"></i>Settings
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Project Progress Chart
        const ctx = document.getElementById('projectProgressChart').getContext('2d');
        const projectProgressChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                datasets: [{
                    label: 'Completed Tasks',
                    data: [12, 19, 23, 35, 42, 45],
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    tension: 0.4
                }, {
                    label: 'New Tasks',
                    data: [15, 22, 28, 30, 38, 40],
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                    },
                    title: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
}
