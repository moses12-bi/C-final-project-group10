@page
@model Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Complete Registration";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Complete Your Registration</h4>
            </div>
            <div class="card-body">
                @if (Model.Invitation == null)
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Invalid Invitation</strong><br>
                        This invitation link is invalid, expired, or has already been used.
                        Please contact your administrator for a new invitation.
                    </div>
                    <div class="text-center">
                        <a href="/Account/Login" class="btn btn-primary">Go to Login</a>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-4">
                        <h6><i class="fas fa-info-circle me-2"></i>Invitation Details</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Email:</strong> @Model.Invitation.Email<br>
                                <strong>Department:</strong> @Model.Invitation.Department<br>
                                <strong>Role:</strong> <span class="badge bg-primary">@Model.Invitation.Role</span>
                            </div>
                            <div class="col-md-6">
                                <strong>Expires:</strong> @Model.Invitation.ExpiresAt.ToShortDateString()<br>
                                <strong>Status:</strong> <span class="badge bg-success">@Model.Invitation.Status</span><br>
                                <strong>Permissions:</strong> @Model.Invitation.Permissions.Count granted
                            </div>
                        </div>
                    </div>

                    <form id="registerForm" method="post">
                        <input type="hidden" asp-for="Token" />
                        
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="Input.FullName" class="form-label">Full Name</label>
                                <input asp-for="Input.FullName" class="form-control" autocomplete="name" required />
                                <span asp-validation-for="Input.FullName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="Input.Email" class="form-label">Email Address</label>
                                <input asp-for="Input.Email" class="form-control" readonly />
                                <small class="text-muted">Email cannot be changed. It's locked to the invited address.</small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.Password" class="form-label">Password</label>
                                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" required />
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" required />
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="card mb-3">
                            <div class="card-header">
                                <h6 class="mb-0"><i class="fas fa-shield-alt me-2"></i>Your Permissions</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    @foreach (var permission in Model.Invitation.Permissions.Where(p => p.Value))
                                    {
                                        <div class="col-md-4 mb-2">
                                            <span class="badge bg-success">
                                                <i class="fas fa-check me-1"></i>@permission.Key
                                            </span>
                                        </div>
                                    }
                                </div>
                                @if (!Model.Invitation.Permissions.Any(p => p.Value))
                                {
                                    <p class="text-muted mb-0">No specific permissions assigned. You'll have basic access.</p>
                                }
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-user-plus me-2"></i>Complete Registration
                            </button>
                            <a href="/Account/Login" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to Login
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
